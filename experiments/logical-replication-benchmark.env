EXPERIMENT_NAME="logical replication marker convergence operation benchmark"
EXPERIMENT_TOPOLOGY="logical-replication"
EXPERIMENT_PG_CONFIG="default"
EXPERIMENT_PROFILE="logical-replication"
EXPERIMENT_PROFILE_SIZE="small"
EXPERIMENT_PROFILE_SETUP=1
EXPERIMENT_PROFILE_RUN=0
EXPERIMENT_RUNTIME_RESET=1
EXPERIMENT_TRUSTED_SHELL=1
EXPERIMENT_BEFORE_SHELL='"$REPO_DIR/scripts/setup_logical_replication.sh"'
EXPERIMENT_WORKLOAD_SPEC="replication/logical-marker-convergence"
EXPERIMENT_ASSERT_SHELL='test -s "$RUN_DIR/artifacts/operation-result.json"; test -s "$RUN_DIR/artifacts/logical-convergence.env"'
EXPERIMENT_METRICS=1
EXPERIMENT_METRICS_SAMPLES="3"
EXPERIMENT_SNAPSHOT="1"
