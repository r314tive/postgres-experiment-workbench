EXPERIMENT_NAME="pgbench benchmark trial through PgBouncer"
EXPERIMENT_TOPOLOGY="pgbouncer"
EXPERIMENT_PG_CONFIG="${EXPERIMENT_PG_CONFIG:-default}"
EXPERIMENT_PROFILE_SETUP=0
EXPERIMENT_PROFILE_RUN=0
EXPERIMENT_WORKLOAD_SPEC="${EXPERIMENT_WORKLOAD_SPEC:-pgbench/tiny}"
EXPERIMENT_METRICS=1
EXPERIMENT_METRICS_INTERVAL="${EXPERIMENT_METRICS_INTERVAL:-1}"
EXPERIMENT_METRICS_DURATION="${EXPERIMENT_METRICS_DURATION:-30}"
EXPERIMENT_SNAPSHOT="${EXPERIMENT_SNAPSHOT:-1}"
EXPERIMENT_RUNTIME_RESET="${EXPERIMENT_RUNTIME_RESET:-1}"
