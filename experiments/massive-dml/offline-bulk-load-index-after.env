EXPERIMENT_NAME="massive-dml offline bulk load with secondary indexes built after load"
EXPERIMENT_TOPOLOGY="single"
EXPERIMENT_PG_CONFIG="default"
EXPERIMENT_PROFILE="massive-dml"
EXPERIMENT_PROFILE_SIZE="small"
EXPERIMENT_PROFILE_SETUP=1
EXPERIMENT_PROFILE_RUN=0
MASSIVE_DML_BULK_LOAD_MODE="index-after"
MASSIVE_DML_BULK_ROWS="20000"
MASSIVE_DML_BULK_PAYLOAD_BYTES="64"
EXPERIMENT_WORKLOAD_SPEC="massive-dml/bulk-load"
EXPERIMENT_ASSERT_SQL_FILES="profiles/massive-dml/sql/84_assert_bulk_load.sql"
EXPERIMENT_TRUSTED_SHELL=1
EXPERIMENT_ASSERT_SHELL='test -s "$RUN_DIR/artifacts/bulk-load-index-after.tsv"; test -s "$RUN_DIR/artifacts/bulk-load-index-after.env"; test -s "$RUN_DIR/artifacts/operation-result.json"'
EXPERIMENT_METRICS=1
EXPERIMENT_METRICS_SAMPLES="3"
EXPERIMENT_SNAPSHOT="1"
