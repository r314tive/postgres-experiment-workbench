EXPERIMENT_NAME="massive-dml partition drop versus row delete"
EXPERIMENT_TOPOLOGY="single"
EXPERIMENT_PG_CONFIG="default"
EXPERIMENT_PROFILE="massive-dml"
EXPERIMENT_PROFILE_SIZE="${EXPERIMENT_PROFILE_SIZE:-small}"
EXPERIMENT_PROFILE_SETUP=1
EXPERIMENT_PROFILE_RUN=0
EXPERIMENT_WORKLOAD_SPEC="massive-dml/partition-remove"
EXPERIMENT_ASSERT_SQL_FILES="profiles/massive-dml/sql/85_assert_partition_comparison.sql"
EXPERIMENT_ASSERT_SHELL='test -s "$RUN_DIR/artifacts/partition-drop-vs-delete.tsv"; test -s "$RUN_DIR/artifacts/partition-drop-vs-delete.env"'
EXPERIMENT_METRICS=1
EXPERIMENT_METRICS_SAMPLES="${EXPERIMENT_METRICS_SAMPLES:-3}"
EXPERIMENT_SNAPSHOT="${EXPERIMENT_SNAPSHOT:-1}"
