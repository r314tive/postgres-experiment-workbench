EXPERIMENT_NAME="massive-dml expected transaction-control failures"
EXPERIMENT_TOPOLOGY="single"
EXPERIMENT_PG_CONFIG="default"
EXPERIMENT_PROFILE="massive-dml"
EXPERIMENT_PROFILE_SIZE="${EXPERIMENT_PROFILE_SIZE:-small}"
EXPERIMENT_PROFILE_SETUP=1
EXPERIMENT_PROFILE_RUN=0
EXPERIMENT_WORKLOAD_SPEC="massive-dml/transaction-caveats"
EXPERIMENT_ASSERT_SQL_FILES="profiles/massive-dml/sql/83_assert_caveat_state.sql"
EXPERIMENT_TRUSTED_SHELL=1
EXPERIMENT_ASSERT_SHELL='test -s "$RUN_DIR/artifacts/procedure-inside-transaction.log"; test -s "$RUN_DIR/artifacts/temp-table-on-commit-drop.log"; test -s "$RUN_DIR/artifacts/transaction-caveats.env"'
EXPERIMENT_METRICS=1
EXPERIMENT_METRICS_SAMPLES="${EXPERIMENT_METRICS_SAMPLES:-1}"
EXPERIMENT_SNAPSHOT="${EXPERIMENT_SNAPSHOT:-1}"
