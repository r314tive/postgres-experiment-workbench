EXPERIMENT_NAME="massive-dml generated committed UPDATE batches"
EXPERIMENT_TOPOLOGY="single"
EXPERIMENT_PG_CONFIG="default"
EXPERIMENT_PROFILE="massive-dml"
EXPERIMENT_PROFILE_SIZE="${EXPERIMENT_PROFILE_SIZE:-small}"
EXPERIMENT_PROFILE_SETUP=1
EXPERIMENT_PROFILE_RUN=0
EXPERIMENT_WORKLOAD_SPEC="massive-dml/generated-update"
EXPERIMENT_BACKGROUND_SPECS="${MASSIVE_DML_BACKGROUND_SPECS:-}"
EXPERIMENT_BACKGROUND_WARMUP="${MASSIVE_DML_BACKGROUND_WARMUP:-0}"
EXPERIMENT_ASSERT_SQL_FILES="profiles/massive-dml/sql/80_assert_update_complete.sql"
EXPERIMENT_TRUSTED_SHELL=1
EXPERIMENT_ASSERT_SHELL='artifact="$RUN_DIR/artifacts/generated-update.sql"; test -s "$artifact"; begins="$(grep -c "^BEGIN;$" "$artifact")"; commits="$(grep -c "^COMMIT;$" "$artifact")"; test "$begins" -gt 0; test "$begins" -eq "$commits"'
EXPERIMENT_METRICS=1
EXPERIMENT_METRICS_SAMPLES="${EXPERIMENT_METRICS_SAMPLES:-3}"
EXPERIMENT_SNAPSHOT="${EXPERIMENT_SNAPSHOT:-1}"
