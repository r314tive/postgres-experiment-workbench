EXPERIMENT_NAME="manual VACUUM ANALYZE operation benchmark"
EXPERIMENT_TOPOLOGY="single"
EXPERIMENT_PG_CONFIG="default"
EXPERIMENT_PROFILE="vacuum-bloat"
EXPERIMENT_PROFILE_SIZE="medium"
EXPERIMENT_PROFILE_SETUP=1
EXPERIMENT_PROFILE_RUN=0
EXPERIMENT_WORKLOAD_SPEC="maintenance/vacuum-bloat"
EXPERIMENT_ASSERT_SQL_FILES="profiles/vacuum-bloat/sql/80_assert_benchmark.sql"
EXPERIMENT_TRUSTED_SHELL=1
EXPERIMENT_ASSERT_SHELL='test -s "$RUN_DIR/artifacts/operation-result.json"'
EXPERIMENT_METRICS=1
EXPERIMENT_METRICS_SAMPLES="3"
EXPERIMENT_SNAPSHOT="1"
