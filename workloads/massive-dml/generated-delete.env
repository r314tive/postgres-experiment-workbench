WORKLOAD_NAME="massive-dml generated committed DELETE batches"
WORKLOAD_KIND="shell"
WORKLOAD_CMD='"$REPO_DIR/profiles/massive-dml/scripts/run_generated.sh" delete'
MASSIVE_DML_BATCH_SIZE="${MASSIVE_DML_BATCH_SIZE:-}"
MASSIVE_DML_SLEEP_SECONDS="${MASSIVE_DML_SLEEP_SECONDS:-0}"
