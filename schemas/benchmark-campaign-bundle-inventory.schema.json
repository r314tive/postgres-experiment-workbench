{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/r314tive/postgres-experiment-workbench/schemas/benchmark-campaign-bundle-inventory.schema.json",
  "title": "pgworkbench benchmark campaign bundle inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "campaign_id", "campaign_ref", "series_refs", "files"],
  "properties": {
    "schema_version": {"const": "pgworkbench.benchmark-campaign-bundle/v1"},
    "artifact_type": {"const": "pgworkbench.benchmark-campaign-bundle"},
    "campaign_id": {"type": "string", "minLength": 1, "maxLength": 180, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "campaign_ref": {"type": "string", "pattern": "^runs/benchmark-campaign/[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "series_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^runs/benchmarks/[A-Za-z0-9][A-Za-z0-9._-]*$"}},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}
  },
  "$defs": {
    "portable_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))(?!.*\\\\)(?!.*:).+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "digest"],
      "properties": {
        "path": {"$ref": "#/$defs/portable_path"},
        "size": {"type": "integer", "minimum": 0},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
