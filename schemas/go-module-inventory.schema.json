{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/r314tive/postgres-experiment-workbench/schemas/go-module-inventory.schema.json",
  "title": "pgworkbench exact Go module inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module_path", "modules"],
  "properties": {
    "schema_version": {"const": "pgworkbench.go-module-inventory/v1"},
    "module_path": {"const": "github.com/r314tive/postgres-experiment-workbench"},
    "modules": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"$ref": "#/$defs/regexp2"},
        {"$ref": "#/$defs/jsonschema"},
        {"$ref": "#/$defs/xText"}
      ],
      "items": false
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "scope", "module_sum", "go_mod_sum", "license", "license_files"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._~/-]*$"},
        "version": {"type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"},
        "scope": {"enum": ["test", "runtime"]},
        "module_sum": {"$ref": "#/$defs/goSum"},
        "go_mod_sum": {"$ref": "#/$defs/goSum"},
        "license": {"enum": ["Apache-2.0", "BSD-3-Clause", "MIT"]},
        "license_files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/licenseFile"}
        }
      }
    },
    "regexp2": {
      "allOf": [
        {"$ref": "#/$defs/module"},
        {
          "properties": {
            "path": {"const": "github.com/dlclark/regexp2"},
            "version": {"const": "v1.11.0"},
            "scope": {"const": "test"},
            "module_sum": {"const": "h1:G/nrcoOa7ZXlpoa/91N3X7mM3r8eIlMBBJZvsz/mxKI="},
            "go_mod_sum": {"const": "h1:DHkYz0B9wPfa6wondMfaivmHpzrQ3v9q8cnmRbL6yW8="},
            "license": {"const": "MIT"},
            "license_files": {
              "const": [
                {
                  "path": "third_party/licenses/github.com/dlclark/regexp2/v1.11.0/ATTRIB",
                  "sha256": "sha256:8db174fc98abc02f154c20ffdacdfbd37528ef25e0f098e20a2c21defd76329a"
                },
                {
                  "path": "third_party/licenses/github.com/dlclark/regexp2/v1.11.0/LICENSE",
                  "sha256": "sha256:9be5d04bb4d706914d5bf943710da4afeb42048f7c529902fb57c82762a991a9"
                }
              ]
            }
          }
        }
      ]
    },
    "jsonschema": {
      "allOf": [
        {"$ref": "#/$defs/module"},
        {
          "properties": {
            "path": {"const": "github.com/santhosh-tekuri/jsonschema/v6"},
            "version": {"const": "v6.0.2"},
            "scope": {"const": "test"},
            "module_sum": {"const": "h1:KRzFb2m7YtdldCEkzs6KqmJw4nqEVZGK7IN2kJkjTuQ="},
            "go_mod_sum": {"const": "h1:JXeL+ps8p7/KNMjDQk3TCwPpBy0wYklyWTfbkIzdIFU="},
            "license": {"const": "Apache-2.0"},
            "license_files": {
              "const": [
                {
                  "path": "third_party/licenses/github.com/santhosh-tekuri/jsonschema/v6/v6.0.2/LICENSE",
                  "sha256": "sha256:09e8a9bcec8067104652c168685ab0931e7868f9c8284b66f5ae6edae5f1130b"
                }
              ]
            }
          }
        }
      ]
    },
    "xText": {
      "allOf": [
        {"$ref": "#/$defs/module"},
        {
          "properties": {
            "path": {"const": "golang.org/x/text"},
            "version": {"const": "v0.14.0"},
            "scope": {"const": "test"},
            "module_sum": {"const": "h1:ScX5w1eTa3QqT8oi6+ziP7dTV1S2+ALU0bI+0zXKWiQ="},
            "go_mod_sum": {"const": "h1:18ZOQIKpY8NJVqYksKHtTdi31H5itFRjB5/qKTNYzSU="},
            "license": {"const": "BSD-3-Clause"},
            "license_files": {
              "const": [
                {
                  "path": "third_party/licenses/golang.org/x/text/v0.14.0/LICENSE",
                  "sha256": "sha256:2d36597f7117c38b006835ae7f537487207d8ec407aa9d9980794b2030cbc067"
                },
                {
                  "path": "third_party/licenses/golang.org/x/text/v0.14.0/PATENTS",
                  "sha256": "sha256:96f408bfae65bf137fc2525d3ecb030271c50c1e90799f87abf8846d8dd505cc"
                }
              ]
            }
          }
        }
      ]
    },
    "licenseFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^third_party/licenses/(?!.*(^|/)\\.\\.(/|$)).+$"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "goSum": {"type": "string", "pattern": "^h1:[A-Za-z0-9+/]{43}=$"}
  }
}
