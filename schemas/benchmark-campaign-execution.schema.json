{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/r314tive/postgres-experiment-workbench/schemas/benchmark-campaign-execution.schema.json",
  "title": "pgworkbench benchmark campaign execution v1",
  "description": "One append-only campaign execution receipt. Unverified rows contain no performance value.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "position", "benchmark", "series_run_id", "spec_digest", "protocol_digest", "comparison_key_digest", "class", "primary_metric", "direction", "status", "evidence_status", "trials_planned", "trials_valid", "trials_failed", "trials_invalid", "reasons", "digest"],
  "properties": {
    "schema_version": {"const": "pgworkbench.benchmark-campaign-execution/v1"},
    "artifact_type": {"const": "pgworkbench.benchmark-campaign-execution"},
    "position": {"type": "integer", "minimum": 1, "maximum": 1000},
    "benchmark": {"type": "string", "minLength": 1},
    "series_run_id": {"$ref": "#/$defs/run_id"},
    "series_ref": {"type": "string", "pattern": "^runs/benchmarks/[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "result_digest": {"$ref": "#/$defs/digest"},
    "spec_digest": {"$ref": "#/$defs/digest"},
    "protocol_digest": {"$ref": "#/$defs/digest"},
    "comparison_key_digest": {"$ref": "#/$defs/digest"},
    "class": {"enum": ["smoke", "measurement"]},
    "primary_metric": {"type": "string", "minLength": 1},
    "direction": {"enum": ["higher", "lower"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["passed", "failed", "invalid", "inconclusive", "unavailable"]},
    "evidence_status": {"enum": ["verified", "unverified"]},
    "trials_planned": {"type": "integer", "minimum": 0},
    "trials_valid": {"type": "integer", "minimum": 0},
    "trials_failed": {"type": "integer", "minimum": 0},
    "trials_invalid": {"type": "integer", "minimum": 0},
    "median": {"type": "number"},
    "cv_pct": {"type": "number", "minimum": 0},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"evidence_status": {"const": "verified"}}},
      "then": {"required": ["series_ref", "result_digest", "started_at", "finished_at"], "properties": {"status": {"enum": ["passed", "failed", "invalid", "inconclusive"]}}}
    },
    {
      "if": {"properties": {"evidence_status": {"const": "unverified"}}},
      "then": {
        "properties": {"status": {"const": "unavailable"}, "trials_planned": {"const": 0}, "trials_valid": {"const": 0}, "trials_failed": {"const": 0}, "trials_invalid": {"const": 0}},
        "not": {
          "anyOf": [
            {"required": ["series_ref"]},
            {"required": ["result_digest"]},
            {"required": ["started_at"]},
            {"required": ["finished_at"]},
            {"required": ["median"]},
            {"required": ["cv_pct"]}
          ]
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 180, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}
  }
}
