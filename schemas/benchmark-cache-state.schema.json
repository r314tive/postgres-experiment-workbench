{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/r314tive/postgres-experiment-workbench/schemas/benchmark-cache-state.schema.json",
  "title": "pgworkbench benchmark cache state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "run_id", "protocol_digest", "trial", "captured_at", "assurance", "observation_method", "boundary", "snapshot_semantics", "boundary_window", "raw_source", "mode", "target_relations", "relations", "status", "reasons", "digest"],
  "properties": {
    "schema_version": { "const": "pgworkbench.benchmark-cache-state/v1" },
    "artifact_type": { "const": "pgworkbench.benchmark-cache-state" },
    "run_id": { "$ref": "#/$defs/runID" },
    "protocol_digest": { "$ref": "#/$defs/digest" },
    "trial": { "type": "integer", "minimum": 1 },
    "captured_at": { "$ref": "#/$defs/timestamp" },
    "assurance": { "$ref": "#/$defs/assurance" },
    "observation_method": { "const": "pg_buffercache-resident-block-count/v1" },
    "boundary": { "const": "before-measure" },
    "snapshot_semantics": { "const": "single-transaction-repeatable-read/v1" },
    "boundary_window": { "$ref": "#/$defs/window" },
    "raw_source": { "$ref": "#/$defs/source" },
    "mode": { "enum": ["uncontrolled", "postgres-shared-buffer-warm"] },
    "target_relations": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relationName" }
    },
    "min_resident_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
    "relations": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relation", "database_oid", "relation_oid", "fork", "relation_blocks", "resident_blocks", "resident_pct"],
        "properties": {
          "relation": { "$ref": "#/$defs/relationName" },
          "database_oid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
          "relation_oid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
          "fork": { "const": "main" },
          "relation_blocks": { "type": "integer", "minimum": 1 },
          "resident_blocks": { "type": "integer", "minimum": 0 },
          "resident_pct": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "status": { "enum": ["uncontrolled", "satisfied", "unsatisfied"] },
    "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "uncontrolled" } } },
      "then": {
        "properties": { "target_relations": { "maxItems": 0 }, "relations": { "maxItems": 0 }, "status": { "const": "uncontrolled" } },
        "not": { "required": ["min_resident_pct"] }
      },
      "else": {
        "required": ["min_resident_pct"],
        "properties": { "target_relations": { "minItems": 1 }, "relations": { "minItems": 1 }, "status": { "enum": ["satisfied", "unsatisfied"] } }
      }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "runID": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "relationName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$" },
    "window": {
      "type": "object", "additionalProperties": false, "required": ["started_at", "finished_at"],
      "properties": { "started_at": { "$ref": "#/$defs/timestamp" }, "finished_at": { "$ref": "#/$defs/timestamp" } }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["path", "digest", "size_bytes"],
      "properties": { "path": { "const": "cache-state.tsv" }, "digest": { "$ref": "#/$defs/digest" }, "size_bytes": { "type": "integer", "minimum": 1, "maximum": 2097152 } }
    },
    "assurance": {
      "type": "object", "additionalProperties": false, "required": ["evidence_origin", "signed", "digest_purpose", "verification_scope"],
      "properties": {
        "evidence_origin": { "const": "runner-recorded" }, "signed": { "const": false }, "digest_purpose": { "const": "content-integrity-only" },
        "verification_scope": { "const": "structure-digest-raw-source-and-postgres-shared-buffer-residency-derivation-only" }
      }
    }
  }
}
