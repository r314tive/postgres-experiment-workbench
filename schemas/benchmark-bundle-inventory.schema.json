{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/r314tive/postgres-experiment-workbench/schemas/benchmark-bundle-inventory.schema.json",
  "title": "pgworkbench benchmark bundle inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "series_run_id",
    "series_ref",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "pgworkbench.benchmark-bundle/v1"
    },
    "artifact_type": {
      "const": "pgworkbench.benchmark-bundle"
    },
    "series_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "series_ref": {
      "$ref": "#/$defs/portablePath"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "digest"],
        "properties": {
          "path": {
            "$ref": "#/$defs/portablePath"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
    }
  }
}
