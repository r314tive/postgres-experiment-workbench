{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/r314tive/postgres-experiment-workbench/schemas/benchmark-effective-settings.schema.json",
  "title": "pgworkbench effective PostgreSQL settings evidence v1",
  "description": "Narrow, run-bound normalization of only the pg_settings rows named by a counterbalanced A/B protocol.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "parser_version",
    "run_id",
    "protocol_digest",
    "trial",
    "captured_at",
    "server_version_num",
    "names",
    "settings",
    "source",
    "phase",
    "digest"
  ],
  "properties": {
    "schema_version": { "const": "pgworkbench.benchmark-effective-settings/v1" },
    "artifact_type": { "const": "pgworkbench.benchmark-effective-settings" },
    "parser_version": { "const": "1.0.0" },
    "run_id": { "$ref": "#/$defs/run_id" },
    "protocol_digest": { "$ref": "#/$defs/digest" },
    "trial": { "type": "integer", "minimum": 1 },
    "captured_at": { "type": "string", "format": "date-time" },
    "server_version_num": { "type": "string", "pattern": "^[1-9][0-9]{4,}$" },
    "names": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/setting_name" }
    },
    "settings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/setting" }
    },
    "source": { "$ref": "#/$defs/source_ref" },
    "phase": { "$ref": "#/$defs/phase_binding" },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "portable_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "setting_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]*$"
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "size"],
      "properties": {
        "path": { "const": "artifacts/benchmark/effective-pg-settings.tsv" },
        "digest": { "$ref": "#/$defs/digest" },
        "size": { "type": "integer", "minimum": 1, "maximum": 1048576 }
      }
    },
    "phase_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "journal_digest", "started_at", "finished_at"],
      "properties": {
        "name": { "const": "prepare" },
        "journal_digest": { "$ref": "#/$defs/digest" },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "setting", "unit", "source", "pending_restart", "context"],
      "properties": {
        "name": { "$ref": "#/$defs/setting_name" },
        "setting": { "type": "string" },
        "unit": { "type": "string" },
        "source": { "type": "string", "minLength": 1 },
        "pending_restart": { "type": "boolean" },
        "context": { "type": "string", "minLength": 1 }
      }
    }
  }
}
