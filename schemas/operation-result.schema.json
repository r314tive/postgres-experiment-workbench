{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/r314tive/postgres-experiment-workbench/schemas/operation-result.schema.json",
  "title": "pgworkbench standardized operation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "operation_id", "variant", "primary_metric", "measurement"],
  "properties": {
    "schema_version": {"const": "pgworkbench.operation-result/v1"},
    "artifact_type": {"const": "pgworkbench.operation-result"},
    "operation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,159}$"},
    "variant": {"type": "string", "minLength": 1},
    "primary_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "unit", "direction", "value"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,159}$"},
        "unit": {"type": "string", "minLength": 1},
        "direction": {"enum": ["lower-is-better", "higher-is-better"]},
        "value": {"type": "number", "minimum": 0}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "scope"],
      "properties": {
        "basis": {"enum": ["postgres-server-clock", "client-monotonic-clock", "tool-reported"]},
        "scope": {"type": "string", "minLength": 1}
      }
    }
  }
}
