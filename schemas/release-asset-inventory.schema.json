{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/r314tive/postgres-experiment-workbench/schemas/release-asset-inventory.schema.json",
  "title": "pgworkbench release asset inventory v1",
  "description": "Closed integrity inventory for one downloaded GitHub release asset root. The record does not authenticate GitHub or its producer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "release_state",
    "tag",
    "git_commit",
    "captured_at",
    "fingerprint_algorithm",
    "asset_fingerprint",
    "assets"
  ],
  "properties": {
    "schema_version": {"const": "pgworkbench.release-asset-inventory/v1"},
    "artifact_type": {"const": "pgworkbench.release-asset-inventory"},
    "release_state": {"enum": ["draft", "published"]},
    "tag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*)|([0-9]*[A-Za-z-][0-9A-Za-z-]*))(\\.((0|[1-9][0-9]*)|([0-9]*[A-Za-z-][0-9A-Za-z-]*)))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "git_commit": {
      "type": "string",
      "pattern": "^(?!(?:0{40}|0{64})$)(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]{0,8}[1-9])?Z$"
    },
    "fingerprint_algorithm": {"const": "github-release-assets-jq-cS/v1"},
    "asset_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assets": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/asset"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "asset_id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "size", "digest"],
      "properties": {
        "id": {"$ref": "#/$defs/asset_id"},
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,254}$"
        },
        "size": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
