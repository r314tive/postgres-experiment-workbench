{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/r314tive/postgres-experiment-workbench/schemas/release-external-driver-verification.schema.json",
  "title": "pgworkbench release external-driver verification v1",
  "description": "Fact-only summary emitted after read-only re-verification of the draft external-driver evidence and release candidate. It contains no caller-selected gate outcome.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "qualification_mode",
    "candidate",
    "captured_at",
    "workflow_run",
    "source",
    "drivers",
    "assurance"
  ],
  "properties": {
    "schema_version": {"const": "pgworkbench.release-external-driver-verification/v1"},
    "artifact_type": {"const": "pgworkbench.release-external-driver-verification"},
    "qualification_mode": {"const": "draft-release-smoke"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]Z$"
    },
    "workflow_run": {"$ref": "#/$defs/workflow_run"},
    "source": {"$ref": "#/$defs/source"},
    "drivers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "prefixItems": [
        {"const": "benchbase-postgresql-33c0047"},
        {"const": "hammerdb-postgresql-6.0"},
        {"const": "sysbench-postgresql-1.0.20"}
      ],
      "items": false
    },
    "assurance": {"$ref": "#/$defs/assurance"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*)|([0-9]*[A-Za-z-][0-9A-Za-z-]*))(\\.((0|[1-9][0-9]*)|([0-9]*[A-Za-z-][0-9A-Za-z-]*)))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "commit": {
      "type": "string",
      "pattern": "^(?!(?:0{40}|0{64})$)(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tag", "git_commit", "asset_fingerprint", "scenario_pack"],
      "properties": {
        "version": {"$ref": "#/$defs/semver"},
        "tag": {
          "type": "string",
          "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*)|([0-9]*[A-Za-z-][0-9A-Za-z-]*))(\\.((0|[1-9][0-9]*)|([0-9]*[A-Za-z-][0-9A-Za-z-]*)))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
        },
        "git_commit": {"$ref": "#/$defs/commit"},
        "asset_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "scenario_pack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "digest"],
          "properties": {
            "id": {"type": "string", "pattern": "^(?=.*[a-z0-9])[a-z0-9._-]+$"},
            "version": {"$ref": "#/$defs/semver"},
            "digest": {"$ref": "#/$defs/digest"}
          }
        }
      }
    },
    "workflow_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "attempt", "head_sha", "repository"],
      "properties": {
        "id": {"type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 32},
        "attempt": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "head_sha": {"$ref": "#/$defs/commit"},
        "repository": {
          "type": "string",
          "minLength": 3,
          "maxLength": 201,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_digest",
        "metadata_archive_digest",
        "provider_artifact",
        "release_archive_digest",
        "release_manifest_digest"
      ],
      "properties": {
        "gate_digest": {"$ref": "#/$defs/digest"},
        "metadata_archive_digest": {"$ref": "#/$defs/digest"},
        "provider_artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "digest"],
          "properties": {
            "id": {"type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 32},
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
            },
            "digest": {"$ref": "#/$defs/digest"}
          }
        },
        "release_archive_digest": {"$ref": "#/$defs/digest"},
        "release_manifest_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "artifact_payload",
        "verification_scope",
        "third_party_runtime_bytes_uploaded",
        "performance_claim",
        "production_decision_eligible",
        "source_to_binary_attested",
        "driver_runtime_closure_attested",
        "host_runtime_dependencies_attested",
        "benchmark_comparability_claim",
        "project_redistribution",
        "all_executions_locally_verified",
        "exact_source_to_staged_file_match",
        "disposable_loopback_target_acknowledged",
        "system_databases_denied",
        "candidate_identity_reverified",
        "provider_artifact_reverified",
        "release_archive_provenance_verified",
        "release_manifest_provenance_verified"
      ],
      "properties": {
        "purpose": {"const": "adapter-compatibility-release-smoke"},
        "artifact_payload": {"const": "metadata-only-no-third-party-runtime-bytes"},
        "verification_scope": {"const": "workflow-local-content-and-semantics"},
        "third_party_runtime_bytes_uploaded": {"const": false},
        "performance_claim": {"const": false},
        "production_decision_eligible": {"const": false},
        "source_to_binary_attested": {"const": false},
        "driver_runtime_closure_attested": {"const": true},
        "host_runtime_dependencies_attested": {"const": false},
        "benchmark_comparability_claim": {"const": false},
        "project_redistribution": {"const": false},
        "all_executions_locally_verified": {"const": true},
        "exact_source_to_staged_file_match": {"const": true},
        "disposable_loopback_target_acknowledged": {"const": true},
        "system_databases_denied": {"const": true},
        "candidate_identity_reverified": {"const": true},
        "provider_artifact_reverified": {"const": true},
        "release_archive_provenance_verified": {"const": true},
        "release_manifest_provenance_verified": {"const": true}
      }
    }
  }
}
