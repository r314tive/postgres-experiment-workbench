{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/r314tive/postgres-experiment-workbench/schemas/benchmark-scenario-pack.schema.json",
  "title": "pgworkbench retained benchmark scenario-pack inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "id",
    "version",
    "digest",
    "manifest",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "pgworkbench.benchmark-scenario-pack/v1"
    },
    "artifact_type": {
      "const": "pgworkbench.benchmark-scenario-pack"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "$ref": "#/$defs/digest"
    },
    "manifest": {
      "$ref": "#/$defs/manifest"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "version", "engine_constraint", "assets"],
      "properties": {
        "schema_version": {
          "const": "pgworkbench.scenario-pack/v1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "engine_constraint": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/portablePath"
          }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size", "executable"],
      "properties": {
        "path": {
          "$ref": "#/$defs/portablePath"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "executable": {
          "type": "boolean"
        }
      }
    }
  }
}
