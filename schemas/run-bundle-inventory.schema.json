{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/r314tive/postgres-experiment-workbench/schemas/run-bundle-inventory.schema.json",
  "title": "pgworkbench run bundle inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "run_id", "files"],
  "properties": {
    "schema_version": {"const": "pgworkbench.run-bundle-inventory/v1"},
    "artifact_type": {"const": "pgworkbench.run-bundle-inventory"},
    "run_id": {"type": "string", "minLength": 1},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "digest"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"},
          "size": {"type": "integer", "minimum": 0},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
