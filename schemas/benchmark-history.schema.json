{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/r314tive/postgres-experiment-workbench/schemas/benchmark-history.schema.json",
  "title": "pgworkbench benchmark history",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "design", "history_id", "run_dir",
    "generated_at", "benchmark", "class", "runtime", "evidence_class",
    "comparison_key_digest", "environment_digest", "primary_metric", "direction",
    "started_at", "finished_at", "status", "conclusion", "reasons", "entries",
    "digest"
  ],
  "properties": {
    "schema_version": {"const": "pgworkbench.benchmark-history/v1"},
    "artifact_type": {"const": "pgworkbench.benchmark-history"},
    "design": {"const": "compatible-series-descriptive-history"},
    "history_id": {"type": "string", "minLength": 1, "maxLength": 180, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "run_dir": {"const": "."},
    "generated_at": {"type": "string", "format": "date-time"},
    "benchmark": {"type": "string", "minLength": 1},
    "class": {"enum": ["smoke", "measurement"]},
    "runtime": {"enum": ["docker", "native"]},
    "evidence_class": {"type": "string", "minLength": 1},
    "comparison_key_digest": {"$ref": "#/$defs/digest"},
    "environment_digest": {"$ref": "#/$defs/digest"},
    "primary_metric": {"type": "string", "minLength": 1},
    "direction": {"enum": ["higher", "lower"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "status": {"const": "passed"},
    "conclusion": {"const": "descriptive"},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "entries": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/entry"}},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id", "series_ref", "result_digest", "subject", "protocol_digest",
        "environment_digest", "pg_config", "pg_config_digest", "started_at",
        "finished_at", "series_status", "trials_valid", "median"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1, "maxLength": 180, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "series_ref": {"type": "string", "pattern": "^runs/benchmarks/[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "result_digest": {"$ref": "#/$defs/digest"},
        "subject": {"type": "string", "minLength": 1},
        "protocol_digest": {"$ref": "#/$defs/digest"},
        "environment_digest": {"$ref": "#/$defs/digest"},
        "pg_config": {"type": "string", "minLength": 1},
        "pg_config_digest": {"$ref": "#/$defs/digest"},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "series_status": {"enum": ["passed", "inconclusive"]},
        "trials_valid": {"type": "integer", "minimum": 1},
        "median": {"type": "number"},
        "cv_pct": {"type": "number", "minimum": 0},
        "change_from_previous_pct": {"type": "number"},
        "change_from_first_pct": {"type": "number"}
      }
    }
  }
}
