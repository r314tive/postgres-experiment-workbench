{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/r314tive/postgres-experiment-workbench/schemas/benchmark-history-bundle-inventory.schema.json",
  "title": "pgworkbench benchmark history bundle inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "history_id", "history_ref", "series_refs", "files"],
  "properties": {
    "schema_version": {"const": "pgworkbench.benchmark-history-bundle/v1"},
    "artifact_type": {"const": "pgworkbench.benchmark-history-bundle"},
    "history_id": {"type": "string", "minLength": 1, "maxLength": 180, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "history_ref": {"type": "string", "pattern": "^runs/benchmark-history/[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "series_refs": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^runs/benchmarks/[A-Za-z0-9][A-Za-z0-9._-]*$"}
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "digest"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 0},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
