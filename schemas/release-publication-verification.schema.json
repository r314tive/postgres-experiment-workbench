{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/r314tive/postgres-experiment-workbench/schemas/release-publication-verification.schema.json",
  "title": "pgworkbench release publication verification v1",
  "description": "Read-only post-publication observation of one immutable public release. The mutating publisher cannot emit this record and the record is not release authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "candidate",
    "captured_at",
    "workflow_run",
    "public_asset_verification",
    "observation",
    "assurance"
  ],
  "properties": {
    "schema_version": {"const": "pgworkbench.release-publication-verification/v1"},
    "artifact_type": {"const": "pgworkbench.release-publication-verification"},
    "candidate": {"$ref": "release-evidence-index.schema.json#/$defs/candidate"},
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]Z$"
    },
    "workflow_run": {
      "allOf": [
        {"$ref": "release-asset-verification.schema.json#/$defs/workflow_run"},
        {
          "properties": {"job": {"const": "public-verify"}},
          "required": ["job"]
        }
      ]
    },
    "public_asset_verification": {
      "allOf": [
        {"$ref": "release-asset-verification.schema.json"},
        {
          "properties": {"qualification_mode": {"const": "published"}},
          "required": ["qualification_mode"]
        }
      ]
    },
    "observation": {"$ref": "#/$defs/observation"},
    "assurance": {"$ref": "#/$defs/assurance"}
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "post_publication_observation",
        "mutation_performed_by_verifier",
        "draft_public_fingerprint_equal",
        "release_state",
        "is_draft",
        "is_immutable",
        "tag_target_sha",
        "asset_count",
        "asset_fingerprint",
        "release_attestation"
      ],
      "properties": {
        "post_publication_observation": {"const": true},
        "mutation_performed_by_verifier": {"const": false},
        "draft_public_fingerprint_equal": {"const": true},
        "release_state": {"const": "published"},
        "is_draft": {"const": false},
        "is_immutable": {"const": true},
        "tag_target_sha": {"type": "string", "pattern": "^(?!(?:0{40}|0{64})$)(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "asset_count": {"const": 16},
        "asset_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "release_attestation": {"const": "verified"}
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "verification_scope",
        "actions_artifact_durable",
        "candidate_identity_reverified",
        "performance_claim",
        "benchmark_comparability_claim",
        "recovery_claim",
        "production_decision_eligible"
      ],
      "properties": {
        "purpose": {"const": "post-publication-read-only-observation"},
        "verification_scope": {"const": "workflow-local-provider-and-content"},
        "actions_artifact_durable": {"const": false},
        "candidate_identity_reverified": {"const": true},
        "performance_claim": {"const": false},
        "benchmark_comparability_claim": {"const": false},
        "recovery_claim": {"const": false},
        "production_decision_eligible": {"const": false}
      }
    }
  }
}
