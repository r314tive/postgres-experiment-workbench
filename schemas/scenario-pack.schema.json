{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/r314tive/postgres-experiment-workbench/schemas/scenario-pack.schema.json",
  "title": "pgworkbench scenario pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "engine_constraint", "assets"],
  "properties": {
    "schema_version": {"const": "pgworkbench.scenario-pack/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "version": {"type": "string", "minLength": 1},
    "engine_constraint": {
      "type": "string",
      "description": "One strict SemVer comparator: >=, =, ^, or ~ followed by major.minor.patch.",
      "pattern": "^(>=|=|\\^|~)(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*)|([0-9]*[A-Za-z-][0-9A-Za-z-]*))(\\.((0|[1-9][0-9]*)|([0-9]*[A-Za-z-][0-9A-Za-z-]*)))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "description": {"type": "string"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"}
    }
  }
}
