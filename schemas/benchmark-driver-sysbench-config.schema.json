{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/r314tive/postgres-experiment-workbench/schemas/benchmark-driver-sysbench-config.schema.json",
  "title": "pgworkbench fixed sysbench native execution config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "threads", "duration_seconds",
    "report_interval_seconds", "rate", "random_seed", "postgresql"
  ],
  "properties": {
    "schema_version": {"const": "pgworkbench.sysbench-native-run-config/v1"},
    "artifact_type": {"const": "pgworkbench.sysbench-native-run-config"},
    "threads": {"type": "integer", "minimum": 1, "maximum": 100000},
    "duration_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "report_interval_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "rate": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "random_seed": {"type": "integer", "minimum": 1},
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "user", "database"],
      "properties": {
        "host": {"type": "string", "minLength": 1, "maxLength": 255},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "user": {"type": "string", "minLength": 1, "maxLength": 255},
        "database": {"type": "string", "minLength": 1, "maxLength": 255}
      }
    }
  }
}
