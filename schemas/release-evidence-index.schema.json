{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/r314tive/postgres-experiment-workbench/schemas/release-evidence-index.schema.json",
  "title": "pgworkbench release evidence index v1, v2, and v3",
  "description": "Durable v1 readiness index for one immutable candidate. V3 persists the typed record and trust boundary of new attachments; the current operator-attested assurance class is not release-authorizing. An Actions artifact reference is not durable evidence by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "record_status",
    "created_at",
    "candidate",
    "preventive_controls",
    "gates",
    "decision"
  ],
  "properties": {
    "schema_version": {"enum": ["pgworkbench.release-evidence-index/v1", "pgworkbench.release-evidence-index/v2", "pgworkbench.release-evidence-index/v3"]},
    "artifact_type": {"const": "pgworkbench.release-evidence-index"},
    "lineage": {"$ref": "#/$defs/lineage"},
    "record_status": {"enum": ["template", "active", "complete"]},
    "created_at": {"type": "string", "format": "date-time"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "preventive_controls": {"$ref": "#/$defs/preventive_controls"},
    "gates": {"$ref": "#/$defs/gates"},
    "decision": {"$ref": "#/$defs/decision"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": "pgworkbench.release-evidence-index/v1"}},
        "required": ["schema_version"]
      },
      "then": {"not": {"required": ["lineage"]}}
    },
    {
      "if": {
        "properties": {"schema_version": {"const": "pgworkbench.release-evidence-index/v2"}},
        "required": ["schema_version"]
      },
      "then": {"required": ["lineage"]}
    },
    {
      "if": {
        "properties": {"schema_version": {"const": "pgworkbench.release-evidence-index/v3"}},
        "required": ["schema_version"]
      },
      "then": {
        "required": ["lineage"],
        "properties": {
          "record_status": {"enum": ["template", "active"]},
          "decision": {
            "properties": {"status": {"const": "no-go"}},
            "required": ["status"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"record_status": {"const": "complete"}},
        "required": ["record_status"]
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {"status": {"const": "go"}},
            "required": ["status"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "properties": {"status": {"const": "go"}},
            "required": ["status"]
          }
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "record_status": {"const": "complete"},
          "preventive_controls": {
            "properties": {
              "tag_ruleset": {
                "properties": {
                  "status": {"const": "verified"},
                  "bypass_review": {
                    "properties": {"status": {"const": "admin-reviewed"}},
                    "required": ["status"]
                  }
                },
                "required": ["status", "bypass_review"]
              },
              "immutable_releases": {
                "properties": {
                  "status": {"const": "verified"},
                  "enabled": {"const": true}
                },
                "required": ["status", "enabled"]
              }
            },
            "required": ["tag_ruleset", "immutable_releases"]
          },
          "gates": {"$ref": "#/$defs/passed_gates"}
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*)|([0-9]*[A-Za-z-][0-9A-Za-z-]*))(\\.((0|[1-9][0-9]*)|([0-9]*[A-Za-z-][0-9A-Za-z-]*)))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision"],
      "properties": {
        "revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "previous_index_digest": {"$ref": "#/$defs/digest"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"revision": {"const": 0}},
            "required": ["revision"]
          },
          "then": {"not": {"required": ["previous_index_digest"]}},
          "else": {"required": ["previous_index_digest"]}
        }
      ]
    },
    "commit": {
      "type": "string",
      "pattern": "^(?!(?:0{40}|0{64})$)(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest", "captured_at"],
      "properties": {
        "ref": {"type": "string", "format": "uri", "pattern": "^(?:https|s3|gs|urn):"},
        "digest": {"$ref": "#/$defs/digest"},
        "captured_at": {"type": "string", "format": "date-time"},
        "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "run_attempt": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "record": {"$ref": "#/$defs/evidence_record"},
        "assurance": {"$ref": "#/$defs/evidence_assurance"}
      },
      "dependentRequired": {
        "record": ["assurance"],
        "assurance": ["record"]
      }
    },
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "artifact_type"],
      "properties": {
        "schema_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "artifact_type": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "evidence_assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durability", "authenticity"],
      "properties": {
        "durability": {"const": "operator-asserted-not-verified"},
        "authenticity": {"const": "record-semantics-verified-remote-authenticity-not-verified"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tag", "git_commit", "asset_fingerprint", "scenario_pack"],
      "properties": {
        "version": {"$ref": "#/$defs/semver"},
        "tag": {"type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*)|([0-9]*[A-Za-z-][0-9A-Za-z-]*))(\\.((0|[1-9][0-9]*)|([0-9]*[A-Za-z-][0-9A-Za-z-]*)))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"},
        "git_commit": {"$ref": "#/$defs/commit"},
        "asset_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "scenario_pack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "digest"],
          "properties": {
            "id": {"type": "string", "pattern": "^(?=.*[a-z0-9])[a-z0-9._-]+$"},
            "version": {"$ref": "#/$defs/semver"},
            "digest": {"$ref": "#/$defs/digest"}
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["open", "passed", "failed"]},
        "evidence": {"$ref": "#/$defs/evidence"},
        "note": {"type": "string", "minLength": 1, "maxLength": 1000}
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"enum": ["passed", "failed"]}},
            "required": ["status"]
          },
          "then": {"required": ["evidence"]},
          "else": {"not": {"required": ["evidence"]}}
        }
      ]
    },
    "admin_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["open", "admin-reviewed"]},
        "reviewer": {"type": "string", "minLength": 1, "maxLength": 128},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "ruleset_id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "ruleset_updated_at": {"type": "string", "format": "date-time"},
        "evidence": {"$ref": "#/$defs/evidence"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "admin-reviewed"}},
            "required": ["status"]
          },
          "then": {"required": ["reviewer", "reviewed_at", "ruleset_id", "ruleset_updated_at", "evidence"]},
          "else": {
            "not": {"anyOf": [{"required": ["reviewer"]}, {"required": ["reviewed_at"]}, {"required": ["ruleset_id"]}, {"required": ["ruleset_updated_at"]}, {"required": ["evidence"]}]}
          }
        }
      ]
    },
    "preventive_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag_ruleset", "immutable_releases"],
      "properties": {
        "tag_ruleset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "target", "enforcement", "include_pattern", "excludes", "creation_restricted", "update_prohibited", "deletion_prohibited", "bypass_review"],
          "properties": {
            "status": {"enum": ["open", "verified"]},
            "target": {"const": "tag"},
            "enforcement": {"const": "active"},
            "include_pattern": {"const": "refs/tags/v*"},
            "excludes": {"type": "array", "maxItems": 0},
            "creation_restricted": {"const": true},
            "update_prohibited": {"const": true},
            "deletion_prohibited": {"const": true},
            "api_evidence": {"$ref": "#/$defs/evidence"},
            "bypass_review": {"$ref": "#/$defs/admin_review"}
          },
          "allOf": [
            {
              "if": {"properties": {"status": {"const": "verified"}}, "required": ["status"]},
              "then": {"required": ["api_evidence"]},
              "else": {"not": {"required": ["api_evidence"]}}
            }
          ]
        },
        "immutable_releases": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "enabled"],
          "properties": {
            "status": {"enum": ["open", "verified"]},
            "enabled": {"type": "boolean"},
            "api_evidence": {"$ref": "#/$defs/evidence"}
          },
          "allOf": [
            {
              "if": {"properties": {"status": {"const": "verified"}}, "required": ["status"]},
              "then": {"properties": {"enabled": {"const": true}}, "required": ["api_evidence"]},
              "else": {"not": {"required": ["api_evidence"]}}
            }
          ]
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_compatibility",
        "aggregate_attempt_1",
        "aggregate_attempt_2",
        "draft_asset_verification",
        "draft_compatibility_7_cells",
        "draft_external_drivers",
        "publication",
        "public_asset_verification",
        "published_compatibility_7_cells",
        "critical_finding_review",
        "adoption_pilot_1",
        "adoption_pilot_2",
        "independent_authoring_reproduction"
      ],
      "properties": {
        "source_compatibility": {"$ref": "#/$defs/gate"},
        "aggregate_attempt_1": {"$ref": "#/$defs/gate"},
        "aggregate_attempt_2": {"$ref": "#/$defs/gate"},
        "draft_asset_verification": {"$ref": "#/$defs/gate"},
        "draft_compatibility_7_cells": {"$ref": "#/$defs/gate"},
        "draft_external_drivers": {"$ref": "#/$defs/gate"},
        "publication": {"$ref": "#/$defs/gate"},
        "public_asset_verification": {"$ref": "#/$defs/gate"},
        "published_compatibility_7_cells": {"$ref": "#/$defs/gate"},
        "critical_finding_review": {"$ref": "#/$defs/gate"},
        "adoption_pilot_1": {"$ref": "#/$defs/gate"},
        "adoption_pilot_2": {"$ref": "#/$defs/gate"},
        "independent_authoring_reproduction": {"$ref": "#/$defs/gate"}
      }
    },
    "passed_gate": {
      "allOf": [
        {"$ref": "#/$defs/gate"},
        {"properties": {"status": {"const": "passed"}}, "required": ["status", "evidence"]}
      ]
    },
    "passed_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_compatibility",
        "aggregate_attempt_1",
        "aggregate_attempt_2",
        "draft_asset_verification",
        "draft_compatibility_7_cells",
        "draft_external_drivers",
        "publication",
        "public_asset_verification",
        "published_compatibility_7_cells",
        "critical_finding_review",
        "adoption_pilot_1",
        "adoption_pilot_2",
        "independent_authoring_reproduction"
      ],
      "properties": {
        "source_compatibility": {"$ref": "#/$defs/passed_gate"},
        "aggregate_attempt_1": {"$ref": "#/$defs/passed_gate"},
        "aggregate_attempt_2": {"$ref": "#/$defs/passed_gate"},
        "draft_asset_verification": {"$ref": "#/$defs/passed_gate"},
        "draft_compatibility_7_cells": {"$ref": "#/$defs/passed_gate"},
        "draft_external_drivers": {"$ref": "#/$defs/passed_gate"},
        "publication": {"$ref": "#/$defs/passed_gate"},
        "public_asset_verification": {"$ref": "#/$defs/passed_gate"},
        "published_compatibility_7_cells": {"$ref": "#/$defs/passed_gate"},
        "critical_finding_review": {"$ref": "#/$defs/passed_gate"},
        "adoption_pilot_1": {"$ref": "#/$defs/passed_gate"},
        "adoption_pilot_2": {"$ref": "#/$defs/passed_gate"},
        "independent_authoring_reproduction": {"$ref": "#/$defs/passed_gate"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "status", "recorded_at", "reasons"],
      "properties": {
        "scope": {"const": "v1-readiness"},
        "status": {"enum": ["no-go", "go"]},
        "recorded_at": {"type": "string", "format": "date-time"},
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    }
  }
}
