{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/r314tive/postgres-experiment-workbench/schemas/benchmark-campaign-protocol.schema.json",
  "title": "pgworkbench benchmark campaign protocol v1",
  "description": "Immutable ordered declaration of independent benchmark series. Items need not be comparable and no aggregate score or decision is defined.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "scheduler_version", "design", "campaign_id", "runtime", "subject", "ordered_series", "digest"],
  "properties": {
    "schema_version": {"const": "pgworkbench.benchmark-campaign-protocol/v1"},
    "artifact_type": {"const": "pgworkbench.benchmark-campaign-protocol"},
    "scheduler_version": {"const": "1.0.0"},
    "design": {"const": "ordered-independent-series-campaign"},
    "campaign_id": {"$ref": "#/$defs/run_id"},
    "runtime": {"enum": ["docker", "native"]},
    "subject": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n]+$"},
    "ordered_series": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/planned_series"}},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 180, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "portable_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"},
    "planned_series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "benchmark", "series_run_id", "spec_ref", "spec_digest", "protocol_digest", "comparison_key_digest", "class", "primary_metric", "direction"],
      "properties": {
        "position": {"type": "integer", "minimum": 1, "maximum": 1000},
        "benchmark": {"type": "string", "minLength": 1},
        "series_run_id": {"$ref": "#/$defs/run_id"},
        "spec_ref": {"$ref": "#/$defs/portable_path"},
        "spec_digest": {"$ref": "#/$defs/digest"},
        "protocol_digest": {"$ref": "#/$defs/digest"},
        "comparison_key_digest": {"$ref": "#/$defs/digest"},
        "class": {"enum": ["smoke", "measurement"]},
        "primary_metric": {"type": "string", "minLength": 1},
        "direction": {"enum": ["higher", "lower"]}
      }
    }
  }
}
